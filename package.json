{
  "name": "pi-mcp-viz",
  "version": "0.2.0",
  "description": "Visualizes MCP server activity in Pi: transcript cards, auto-dismissing modals and a status-line badge, with a token counter for documents read by the MCP servers (knowledge base included).",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "license": "MIT",
  "author": "mastnacek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-mcp-viz.git"
  },
  "bugs": {
    "url": "https://github.com/mastnacek/pi-mcp-viz/issues"
  },
  "homepage": "https://github.com/mastnacek/pi-mcp-viz#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "mcp",
    "model-context-protocol",
    "observability",
    "tui",
    "tokens"
  ],
  "files": [
    "src",
    "index.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/*.test.js\""
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  }
}
